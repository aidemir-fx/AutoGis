PORT=3001
HOST=0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=auto_masters
DB_SSLMODE=disable

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_EXPIRE=15
JWT_REFRESH_EXPIRE=24

# Environment
ENVIRONMENT=development
ENABLE_RUNTIME_MIGRATIONS=false

# Frontend
FRONTEND_URL=http://localhost:5173

# ─── S3 / Media Storage ────────────────────────────────────────────────────────
# Bucket name per environment: autogis-media-dev | autogis-media-stage | autogis-media-prod
S3_BUCKET=autogis-media-dev
S3_REGION=us-east-1

# Custom endpoint for local development with MinIO (leave empty for real AWS)
S3_ENDPOINT=http://localhost:9000

# Static credentials for local dev / CI. In production leave empty and use IAM role.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ARN of the KMS customer managed key. Leave empty to skip SSE-KMS (dev only).
# Production: arn:aws:kms:us-east-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
S3_KMS_KEY_ID=

# Public CDN base URL (no trailing slash).
# Dev: direct MinIO URL. Prod: your CloudFront domain.
CDN_BASE_URL=http://localhost:9000/autogis-media-dev
